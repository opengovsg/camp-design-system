{
  "name": "token-gen",
  "version": "1.0.0",
  "description": "OGP Design System token generator",
  "scripts": {
    "prebuild": "rimraf tokens/raw/* tokens/transformed/*",
    "transform": "node split.js && token-transformer tokens-generated/raw --theme --themeOutputPath=tokens-generated/transformed",
    "build": "pnpm run transform && node build.js",
    "postbuild": "pnpm run lint",
    "lint": "prettier . -c --write"
  },
  "author": "karrui@open.gov.sg",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "json5": "^2.2.2",
    "lodash": "^4.18.1",
    "prettier": "3.2.5",
    "rimraf": "^6.0.1",
    "style-dictionary": "^5.7.0",
    "tinycolor2": "^1.6.0",
    "token-transformer": "^0.0.33"
  },
  "private": true
}
