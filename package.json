{
  "name": "root",
  "description": "Repository containing the Open Government Products design system",
  "private": true,
  "devDependencies": {
    "turbo": "^2.1.3",
    "sherif": "0.10.0",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8"
  },
  "scripts": {
    "build": "turbo build",
    "lint:ws": "sherif",
    "lint:ws:fix": "sherif --fix",
    "postinstall": "pnpm run lint:ws",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile",
    "release": "pnpm --filter @opengovsg/design-system-react build && changeset publish"
  },
  "packageManager": "pnpm@12.14.0"
}
